{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Jwt": {
    "Emisor": "aula-lista",
    "Audiencia": "aula-lista"
  },
  "AllowedHosts": "*",
  "Cuentas": {
    "UrlWeb": "http://localhost:8080",
    "MinutosTokenAcceso": 15,
    "DiasSesion": 30,
    "IntentosInicioSesionPorMinuto": 5,
    "ReenviosVerificacionPorHora": 3,
    "MinutosReautenticacionGoogle": 10,
    "VersionesLegales": {
      "Terminos": "2026-10-11",
      "Privacidad": "2026-10-11",
      "DeclaracionDatos": "2026-10-11"
    }
  },
  "Correo": {
    "Proveedor": "buzon",
    "Remitente": "no-responder@aulalista.mx",
    "NombreRemitente": "Aula Lista"
  },
  "Almacen": {
    "Ruta": "/var/lib/aula-lista/archivos"
  },
  "Trabajos": {
    "Servidor": true
  }
}