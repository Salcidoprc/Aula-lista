# Copia este archivo a infra/.env y cambia los valores. infra/.env nunca se sube al repositorio.
CLAVE_POSTGRES=cambia-esta-clave
CLAVE_APP_MIGRACIONES=cambia-esta-clave
CLAVE_APP_RUNTIME=cambia-esta-clave
# Al menos 32 caracteres.
JWT_CLAVE_FIRMA=cambia-esta-clave-de-al-menos-32-caracteres

# Cuenta docente (SPEC-01, ADR-0013).
# URL pública de la web: se usa en los enlaces de los correos y al volver de Google.
URL_WEB=http://localhost:8080
# Correo: "buzon" guarda los correos en memoria (ver GET /api/v1/desarrollo/correos); "brevo" los envía de verdad.
CORREO_PROVEEDOR=buzon
# Secreto: solo con CORREO_PROVEEDOR=brevo. Déjalo vacío en local.
BREVO_API_KEY=
CORREO_REMITENTE=no-responder@aulalista.mx
# Secretos de Google (OpenID Connect). Vacíos: el botón de Google avisa que no está disponible.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Observaciones con IA (SPEC-04, reglas/05-ia): "simulado" redacta sin red ni costo; "claude" usa la API de Claude.
IA_PROVEEDOR=simulado
# El modelo vive en configuración, nunca en el código (ADR-0004).
IA_MODELO=claude-haiku-5-5
# Secreto: solo con IA_PROVEEDOR=claude. Déjalo vacío en local.
IA_API_KEY=
# Avisos (SPEC-07). Push del navegador: "simulado" genera claves al arrancar y no envía; "vapid" usa las claves.
PUSH_PROVEEDOR=simulado
# Secretos: solo con PUSH_PROVEEDOR=vapid (npx web-push generate-vapid-keys). Déjalos vacíos en local.
PUSH_CLAVE_PUBLICA=
PUSH_CLAVE_PRIVADA=
# WhatsApp del sistema: "simulado" guarda los mensajes en memoria; "meta" usa la Cloud API.
WHATSAPP_PROVEEDOR=simulado
# Secretos: solo con WHATSAPP_PROVEEDOR=meta. Déjalos vacíos en local.
WHATSAPP_TOKEN=
WHATSAPP_ID_NUMERO=
WHATSAPP_SECRETO_APP=
WHATSAPP_TOKEN_VERIFICACION=
# Pagos (SPEC-08): "simulado" confirma los pagos en la página "Pago de prueba"; "stripe" usa Stripe Checkout.
PAGOS_PROVEEDOR=simulado
# Secretos: solo con PAGOS_PROVEEDOR=stripe (sk_..., whsec_... y los price_... del catálogo). Déjalos vacíos en local.
STRIPE_CLAVE_SECRETA=
STRIPE_SECRETO_WEBHOOK=
STRIPE_PRECIO_PRIMER_GRUPO=
STRIPE_PRECIO_GRUPO_ADICIONAL=
# false si Stripe no aprueba OXXO para el giro de la cuenta (ADR-0009).
OXXO_HABILITADO=true
# false apaga el servidor de trabajos (Hangfire) en esta instancia.
TRABAJOS_SERVIDOR=true
# Monitoreo con Grafana Cloud (SPEC-09, ADR-0015; pasos en docs/operacion/grafana-cloud.md). Vacías en local: no se manda nada.
ENTORNO=local
# Gateway OTLP del stack, por ejemplo https://otlp-gateway-prod-us-east-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=
# Secreto: Authorization=Basic%20<base64 de "instancia:token">
OTEL_EXPORTER_OTLP_HEADERS=
# URL del colector de Faro (Frontend Observability), por ejemplo https://faro-collector-prod-us-east-0.grafana.net/collect/<clave>
FARO_URL=
