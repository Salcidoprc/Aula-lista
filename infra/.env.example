# Copia este archivo a infra/.env y cambia los valores. infra/.env nunca se sube al repositorio.
CLAVE_POSTGRES=cambia-esta-clave
CLAVE_APP_MIGRACIONES=cambia-esta-clave
CLAVE_APP_RUNTIME=cambia-esta-clave
# Al menos 32 caracteres.
JWT_CLAVE_FIRMA=cambia-esta-clave-de-al-menos-32-caracteres

# Cuenta docente (SPEC-01, ADR-0013).
# URL pública de la web: se usa en los enlaces de los correos y al volver de Google.
URL_WEB=http://localhost:8080
# Correo: "buzon" guarda los correos en memoria (ver GET /api/v1/desarrollo/correos); "brevo" los envía de verdad.
CORREO_PROVEEDOR=buzon
# Secreto: solo con CORREO_PROVEEDOR=brevo. Déjalo vacío en local.
BREVO_API_KEY=
CORREO_REMITENTE=no-responder@aulalista.mx
# Secretos de Google (OpenID Connect). Vacíos: el botón de Google avisa que no está disponible.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Observaciones con IA (SPEC-04, reglas/05-ia): "simulado" redacta sin red ni costo; "claude" usa la API de Claude.
IA_PROVEEDOR=simulado
# El modelo vive en configuración, nunca en el código (ADR-0004).
IA_MODELO=claude-haiku-5-5
# Secreto: solo con IA_PROVEEDOR=claude. Déjalo vacío en local.
IA_API_KEY=
# false apaga el servidor de trabajos (Hangfire) en esta instancia.
TRABAJOS_SERVIDOR=true
