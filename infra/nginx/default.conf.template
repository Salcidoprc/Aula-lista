# Detrás de otro proxy con HTTPS (Caddy en staging) se respeta el esquema que él recibió;
# sin proxy delante se usa el de nginx. Así la API arma https:// en el retorno de Google.
map $http_x_forwarded_proto $esquema_original {
  default $http_x_forwarded_proto;
  ""      $scheme;
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  include /etc/nginx/snippets/seguridad.conf;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

  # La API vive detrás del mismo origen para que la cookie de sesión sea HttpOnly y de primera parte.
  location /api/ {
    proxy_pass ${API_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $esquema_original;
  }

  location = /salud {
    proxy_pass ${API_URL};
  }

  # Grafana Faro y /observabilidad.json (ADR-0015); los escribe /docker-entrypoint.d/40-faro.sh según FARO_URL.
  include /etc/nginx/faro/*.conf;

  location = /ngsw-worker.js {
    include /etc/nginx/snippets/seguridad.conf;
    add_header Cache-Control "no-cache" always;
  }

  location = /index.html {
    include /etc/nginx/snippets/seguridad.conf;
    add_header Cache-Control "no-cache" always;
  }

  # mime.types de nginx no conoce .webmanifest.
  location = /manifest.webmanifest {
    types { }
    default_type application/manifest+json;
  }

  location ~* \.(?:js|css|woff2)$ {
    include /etc/nginx/snippets/seguridad.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
