server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  # Content Security Policy estricta (reglas/02-frontend-angular.md).
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

  # La API vive detrás del mismo origen para que la cookie de sesión sea HttpOnly y de primera parte.
  location /api/ {
    proxy_pass ${API_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /salud {
    proxy_pass ${API_URL};
  }

  location = /ngsw-worker.js {
    add_header Cache-Control "no-cache" always;
  }

  location = /index.html {
    add_header Cache-Control "no-cache" always;
  }

  location ~* \.(?:js|css|woff2)$ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
